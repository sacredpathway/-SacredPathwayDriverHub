<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Encryption compliance — answer "No" once, baked into the binary.
	     Driver Hub uses only HTTPS (Supabase + Cloudflare Pages) and the
	     iOS / Apple-provided crypto. No custom cryptography → ECCN 5D002
	     does not apply → ITSAppUsesNonExemptEncryption = NO. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryAddOnlyUsageDescription</key>
	<string>Sacred Pathway needs permission to save generated paystubs and processed documents to your photo library.</string>
	<key>NSContactsUsageDescription</key>
	<string>Sacred Pathway can import broker reps from your iPhone Contacts and save scanned rate-con contacts back to your address book.</string>
	<!-- Location (When In Use only): powers the Live Rate Map, Live Weather
	     Map, the dashboard "Near Me" cards, the Sacred Path truck-stop locator,
	     and trip planning. No Always / background location: in-app
	     turn-by-turn navigation was removed 2026-09-17. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sacred Pathway uses your location to show freight rates, weather, and nearby truck stops and rest areas, and to keep your position centered on the live maps.</string>
	<!-- OpenWeatherMap key, injected from the OPENWEATHERMAP_API_KEY build
	     setting so the literal key is never committed to source. See
	     Config.Weather for setup. -->
	<key>OpenWeatherMapAPIKey</key>
	<string>$(OPENWEATHERMAP_API_KEY)</string>
	<key>NSCameraUsageDescription</key>
	<string>Sacred Pathway uses the camera to scan receipts, rate confirmations, and compliance documents that you choose to add.</string>
	<!-- Background refresh for the maps' freight + weather snapshots. `fetch`
	     and `processing` here ARE the "Background Modes" capability; no extra
	     entitlement is required. See BackgroundRefreshManager. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.sacredpathway.driverhub.maps.refresh</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
</dict>
</plist>
